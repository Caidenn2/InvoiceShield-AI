# Free PDF/OCR extraction and deterministic checks need no environment variables.
# Optional local semantic AI. Install Ollama and pull this model separately.
OLLAMA_MODEL=qwen2.5:1.5b
# Optional hosted inference: use ONLY a Groq Free plan with billing disabled.
GROQ_API_KEY=
GROQ_FREE_PLAN_CONFIRMED=false
# Optional cloud API. Disabled by default, even if credentials exist.
ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional protection for a public demo's paid AI endpoint. Enter in upload dialog.
INVOICE_ANALYSIS_TOKEN=
