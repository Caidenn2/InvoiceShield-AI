{
  "name": "invoiceshield-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-local-assets.cjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-local-assets.cjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.cjs",
    "test:free-demo": "node scripts/free-demo-check.cjs",
    "samples": "node scripts/create-samples.cjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json README.md docs/*.md"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1",
    "ws": "^8.22.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.11.0"
}
